# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Rate limiting salt (any random string)
RATE_LIMIT_SALT=change-me-to-something-random

# Demo agent credentials (pre-seeded in the database)
DEMO_AGENT_EMAIL=demo@darfinder.ai
DEMO_AGENT_PASSWORD=demo-agent-2024
